  <script>
    // Initialize Lucide icons
    lucide.createIcons();
    
    // Initialize Element SDK
    const defaultConfig = {
      brand_name: 'LUXE LENS',
      hero_headline: 'Milestone Moments Told in Editorial Light',
      contact_email: 'hello@luxelens.nj',
      contact_phone: '(708) 555-1234'
    };

    const elementConfig = { ...defaultConfig };

    window.elementSdk.init({
      defaultConfig,
      onConfigChange: async (config) => {
        // Update brand name in header
        const brandEl = document.querySelector('header h1');
        if (brandEl) brandEl.textContent = config.brand_name || defaultConfig.brand_name;
        
        // Update hero headline
        document.querySelectorAll('.hero-headline').forEach(el => {
          el.textContent = config.hero_headline || defaultConfig.hero_headline;
        });
        
        // Update contact info
        const emailLink = document.querySelector('a[href^="mailto:"]');
        if (emailLink) {
          emailLink.href = `mailto:${config.contact_email || defaultConfig.contact_email}`;
          emailLink.textContent = config.contact_email || defaultConfig.contact_email;
        }
        
        const phoneLink = document.querySelector('a[href^="tel:"]');
        if (phoneLink) {
          phoneLink.href = `tel:+${(config.contact_phone || defaultConfig.contact_phone).replace(/\D/g, '')}`;
          phoneLink.textContent = config.contact_phone || defaultConfig.contact_phone;
        }
      },
      mapToCapabilities: (config) => ({
        recolorables: [],
        borderables: [],
        fontEditable: undefined,
        fontSizeable: undefined
      }),
      mapToEditPanelValues: (config) => new Map([
        ['brand_name', config.brand_name || defaultConfig.brand_name],
        ['hero_headline', config.hero_headline || defaultConfig.hero_headline],
        ['contact_email', config.contact_email || defaultConfig.contact_email],
        ['contact_phone', config.contact_phone || defaultConfig.contact_phone]
      ])
    });

    // Button interactions
    document.getElementById('view-collections-btn')?.addEventListener('click', () => {
      document.getElementById('services')?.scrollIntoView({ behavior: 'smooth' });
    });
    
    document.getElementById('book-now-btn')?.addEventListener('click', () => {
      document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
    });
    
    // All pricing buttons
    document.querySelectorAll('.luxury-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
      });
    });
  </script>
